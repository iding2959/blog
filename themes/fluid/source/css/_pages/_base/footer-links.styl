// 页脚友情链接样式

// 覆盖主题默认的 .footer-inner 上内边距（原为 padding 3rem 0 1rem 0），
// 让页脚友链区域整体上移。本文件由 _pages/pages.styl 的 `_base/*` 按字母序导入，
// 排在 base.styl（其内部先导入 _widget/footer.styl）之后，因此可直接覆盖。
.footer-inner
  padding-top 1.5rem

.footer-links-container
  width 100%
  display flex
  justify-content center

.footer-links
  margin-top 0.5rem
  padding-top 0.75rem
  border-top 1px solid var(--line-color)
  max-width 960px
  margin-left auto
  margin-right auto
  width 95%
  
  .footer-links-title
    color var(--sec-text-color)
    font-size 1.1rem
    text-align center
    margin-bottom 1rem
  
  .footer-links-wrapper
    width 100%
    display flex
    justify-content center
    
  .footer-links-items
    display flex
    flex-wrap wrap
    margin -.5rem
    justify-content center
    max-width 960px
    width 100%
    
  .footer-links-item
    display flex
    flex-direction column
    // 定宽：卡片宽度原本由内容撑开，而各项「描述」文本长度不同
    // （描述默认被 max-height 0 收起，但宽度仍参与计算），导致卡片宽窄不一。
    // 13rem 可容纳最长的一条描述单行显示。
    width 13rem
    padding .5rem
    margin .25rem
    color var(--post-text-color)
    background-color var(--link-hover-bg-color)
    border-radius 4px
    transition all .3s ease
    position relative
    overflow hidden
    
    &:hover
      text-decoration none
      color var(--link-hover-color)
      background-color var(--board-color)
      box-shadow 0 2px 8px rgba(0, 0, 0, .1)
      transform translateY(-2px)
      
      .footer-links-item-desc
        max-height 60px
        opacity 1
        transition max-height 0.3s ease, opacity 0.3s ease
    
    .footer-links-item-content
      display flex
      align-items center
      
    .footer-links-item-avatar
      width 20px
      height 20px
      margin-right .5rem
      border-radius 50%
      object-fit cover
      
    .footer-links-item-text
      font-size .9rem
      
    .footer-links-item-desc
      font-size 0.8rem
      color var(--sec-text-color)
      margin-top 0.3rem
      max-height 0
      opacity 0
      overflow hidden
      transition max-height 0.3s ease, opacity 0.3s ease
      
  // 移动端适配
  @media (max-width: 767px)
    max-width 100%
    
    .footer-links-items
      margin -.25rem
      justify-content center
      
    .footer-links-item
      // 小屏不做定宽，交给内容与换行自适应
      width auto
      padding .25rem .5rem
      margin .15rem
      
      .footer-links-item-avatar
        width 16px
        height 16px
        margin-right .3rem
      
      .footer-links-item-text
        font-size .8rem
        
      .footer-links-item-desc
        font-size 0.75rem 

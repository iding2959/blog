// Modified from [hexo-theme-icarus](https://github.com/ppoffice/hexo-theme-icarus)

.license-box
  background-color rgba(#1b1f23, .05)
  transition background-color .2s ease-in-out
  border-radius 4px
  font-size .9rem
  overflow hidden
  padding 1.25rem
  position relative
  z-index 1

  .license-icon
    position absolute
    top 50%
    left 100%

    &::after
      content "\e8e4"
      font-size 12.5rem
      line-height 1
      opacity 0.1
      position relative
      left -.85em
      bottom .5em
      z-index -1

  .license-title
    margin-bottom 1rem

    div:nth-child(1)
      line-height 1.2
      margin-bottom .25rem

    div:nth-child(2)
      color var(--sec-text-color)
      font-size .8rem

  .license-meta
    align-items center
    display flex
    flex-wrap wrap
    justify-content flex-start

    .license-meta-item
      align-items center
      justify-content center
      margin-right 1.5rem

      div:nth-child(1)
        color var(--sec-text-color)
        font-size .8rem
        font-weight normal

      i.iconfont
        font-size 1rem

  .license-notice
    margin-top 1rem
    padding-top .75rem
    border-top 1px solid var(--line-color)
    display flex
    justify-content space-between
    align-items center
    flex-wrap wrap
    
    .license-notice-text
      font-size .85rem
      color var(--sec-text-color)
      font-weight bold
    
    .copy-btn
      border 2px solid var(--post-link-color)
      outline none
      background-color var(--post-link-color)
      color #fff
      padding .5rem 1rem
      border-radius 4px
      font-size .9rem
      font-weight bold
      cursor pointer
      transition all .3s ease-in-out
      box-shadow 0 2px 5px rgba(0, 0, 0, 0.1)
      
      &:hover
        background-color var(--link-hover-color)
        transform translateY(-2px)
        box-shadow 0 4px 8px rgba(0, 0, 0, 0.15)
      
      &.copied
        background-color #28a745
        border-color #28a745
        color #fff

      i.iconfont
        margin-right .4rem
        font-size 1rem

  @media (max-width: 575px) and (min-width: 425px)
    .license-meta

      .license-meta-item
        display flex
        justify-content flex-start
        flex-wrap wrap
        font-size .8rem
        flex 0 0 50%
        max-width 50%
        margin-right 0

        div:nth-child(1)
          margin-right .5rem

      .license-meta-date
        order -1
    
    .license-notice
      flex-direction column
      align-items flex-start
      
      .copy-btn
        margin-top .5rem
        width 100%
        text-align center

  @media (max-width: 424px)
    &::after
      top -65px

    .license-meta
      flex-direction column
      align-items flex-start

      .license-meta-item
        display flex
        flex-wrap wrap
        font-size .8rem

        div:nth-child(1)
          margin-right .5rem
    
    .license-notice
      flex-direction column
      align-items flex-start
      
      .copy-btn
        margin-top .5rem
        width 100%
        text-align center
